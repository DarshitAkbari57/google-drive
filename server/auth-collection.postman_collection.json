                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
                            }
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "file",
                                    "type": "file",
                                    "src": "path/to/your/file.jpg"
                                }
                            ]
                        },
                        "url": {
                            "raw": "http://localhost:5000/api/files/upload/60a60f0f9f1b3d001f5a5b4f",
