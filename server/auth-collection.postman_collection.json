        {
            "name": "File Management",
            "item": [
                {
                    "name": "Create Folder",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"New Folder\"\n}"
                        },
                        "url": {
                            "raw": "http://localhost:5000/api/files/create-folder",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "files",
                                "create-folder"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Upload File",
